#!/bin/sh
# Stand-in for an Apple C compiler when type-checking the macOS target on Linux: build scripts
# (e.g. objc2-exception-helper) need *some* object file, but `cargo clippy` never links it.
# Answers cc-rs' compiler detection and writes an empty file for `-o <out>`, `-o<out>` or
# `-Fo<out>`.
out=""
prev=""
for arg in "$@"; do
  case "$prev" in -o) out="$arg" ;; esac
  case "$arg" in
    --version) echo "fake-cc 1.0"; exit 0 ;;
    -o?*) out="${arg#-o}" ;;
    -Fo?*) out="${arg#-Fo}" ;;
  esac
  prev="$arg"
done
[ -n "$out" ] && : > "$out"
exit 0
