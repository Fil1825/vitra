{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vitra",
  "version": "0.1.0",
  "identifier": "io.github.fil1825.vitra",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Vitra",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 23,
          "y": 33
        }
      },
      {
        "label": "mini",
        "create": false,
        "url": "mini.html",
        "title": "Vitra Mini Player",
        "width": 380,
        "height": 124,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' artwork: http://artwork.localhost theme: http://theme.localhost asset: http://asset.localhost data: blob: https:; font-src 'self' data: theme: http://theme.localhost; media-src 'self' asset: http://asset.localhost blob:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Music player with a Liquid Glass look",
    "longDescription": "Vitra is an open-source desktop music player with a Liquid Glass look, full theming, support for virtually any audio format, link playback and synced lyrics.",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
