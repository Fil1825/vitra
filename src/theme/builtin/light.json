{
  "schemaVersion": 1,
  "id": "light",
  "name": "Light",
  "author": "Vitra",
  "appearance": "light",
  "colors": {
    "background": "#F3F5F9",
    "text": "#11131A",
    "textSecondary": "#11131AA3",
    "textTertiary": "#11131A6B",
    "accent": "#1F86E0",
    "accentContrast": "#FFFFFF",
    "separator": "#11131A1A",
    "danger": "#E5484D"
  },
  "glass": {
    "blur": 28,
    "saturation": 1.8,
    "tint": "#FFFFFF",
    "opacity": 0.55,
    "border": "#FFFFFFB3",
    "borderWidth": 1,
    "highlight": 0.8,
    "highlightColor": "#FFFFFF",
    "refraction": 0.35,
    "shadow": "#0F172A1F",
    "shadowBlur": 32
